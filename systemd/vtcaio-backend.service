[Unit]
Description=VTCAIO backend — mat bat tin hieu 24/7 (ngoai Coolify)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/vtcaio/repo
ExecStart=/usr/bin/docker compose -f docker-compose.catchup.yml up -d backend
ExecStop=/usr/bin/docker compose -f docker-compose.catchup.yml stop backend

[Install]
WantedBy=multi-user.target
