# Bắt buộc ở Prod — copy thành .env.prod rồi điền giá trị thật.
# Dev không cần file này (backend warn + dùng default).
# CHẠY SONG SONG với hệ cũ VTCCatchup: hệ cũ giữ PORT=18080 + path
# /media/ramdisk/live + /mnt/Data/catchup/* + /opt/vtc/conf/sources;
# VTCAIO dùng PORT=18081 + path /media/ramdisk/vtcaio + /mnt/Data/vtcaio/* +
# /opt/vtcaio/conf/sources (đã tách sẵn dưới đây — KHÔNG đổi về path cũ).
VTC_JWT_SECRET=doi-thanh-chuoi-ngau-nhien-64-ky-tu
# Secret ký link xem HLS — ĐẶT GIỐNG NHAU ở backend và frontend (Coolify: 2 resource).
# Lộ secret này = ai cũng tự ký link xem được.
# XOAY KHÔNG DOWNTIME: đặt secret mới vào VTC_HLS_SECRET, chuyển secret cũ xuống
# VTC_HLS_SECRET_PREVIOUS (2 bên giống nhau) → recreate/redeploy → báo đối tác pull
# lại danh mục → khi xong + quá TTL link ngắn nhất thì xóa PREVIOUS → recreate/redeploy.
VTC_HLS_SECRET=doi-thanh-chuoi-ngau-nhien-khac-64-ky-tu
VTC_HLS_SECRET_PREVIOUS=
# Khóa API cho đối tác kéo luồng (VTVgo): "ten:key,ten2:key2", header Authorization: Bearer <key>.
# Key = full quyền API — giữ kín như mật khẩu. Thu hồi = xóa khỏi danh sách + restart backend.
VTC_PARTNER_KEYS=vtvgo:doi-thanh-key-dai-ngau-nhien
VTC_ADMIN_USER=admin
VTC_ADMIN_EMAIL=ky-thuat@don-vi.vn
VTC_ADMIN_PASS=mat-khau-manh-toi-thieu-12-ky-tu
VTC_COOKIE_SECURE=1
VTC_TELEGRAM_BOT_TOKEN=
VTC_TELEGRAM_CHAT_ID=
# Mail khôi phục mật khẩu (để trống = chỉ log link reset ra log file)
VTC_SMTP_HOST=
VTC_SMTP_PORT=587
VTC_SMTP_USER=
VTC_SMTP_PASS=
VTC_SMTP_FROM=VTCAIO <no-reply@vtctech.xyz>
VTC_PUBLIC_BASE_URL=https://vtcaio.vtcrd.top
# EPG đối tác (lịch đã duyệt): base URL + key + nhịp worker (phút).
VTC_EPG_BASE_URL=https://nhaplieu.vtctech.xyz/api/v1
VTC_EPG_API_KEY=
VTC_EPG_SYNC_MINUTES=10
# Card multicast mặc định cho MỌI nguồn ip (VD eth0 172.37.0.200) — đặt 1 lần,
# khỏi sửa từng nguồn. Nguồn nào ghi sẵn --local-address thì giữ nguyên.
VTC_MULTICAST_IFACE=
# Ổ đĩa host chứa captures/exports của VTCAIO (bind vào container, đường trong
# giữ nguyên nên conf/exporter/GC không phải sửa gì).
# VD Windows + ổ E: qua drvfs: /mnt/e/vtcaio/captures. Chú ý: ổ Windows không
# phân biệt hoa-thường → đặt tên kênh nhất quán (VTV1 và vtv1 sẽ đè nhau).
VTC_HOST_CAPTURE_DIR=/mnt/Data/vtcaio/captures
VTC_HOST_EXPORTS_DIR=/mnt/Data/vtcaio/exports
# Vận hành (VTCAIO dùng 18081 để tránh trùng backend hệ cũ :18080 và dashboard Traefik :8080)
PORT=18081
VTC_LOG_DIR=/app/storage/logs
VTC_GC_ENABLE=1
VTC_HLS_WATCHDOG=1
# Transcode SRT/RTMP/UDP-mcast (docs/16): passphrase SRT theo ref — format
# "ref1:mat-khau-1,ref2:mat-khau-2". Ref nằm trong cấu hình output, secret nằm
# ở đây (KHÔNG persist vào DB). Passphrase phải ≥16 ký tự ở Prod.
VTC_SRT_PASSPHRASES=
# Binary override khi path khác mặc định (image chuẩn đã có sẵn cả hai).
VTC_FFMPEG_BIN=
VTC_SRT_BIN=
# Ms chờ tsp ổn định trước khi spawn ffmpeg (mặc định 1000 — chống sốc UDP loopback).
VTC_TC_START_DELAY_MS=1000
# Watchdog ffmpeg stale (fps đứng → tự restart + Telegram). Tắt hẳn = 0.
VTC_TC_WATCHDOG=1
