# Bắt buộc ở Prod — copy thành .env.prod rồi điền giá trị thật.
# Dev không cần file này (backend warn + dùng default).
VTC_JWT_SECRET=doi-thanh-chuoi-ngau-nhien-64-ky-tu
# Secret ký link xem HLS — ĐẶT GIỐNG NHAU ở backend và frontend (Coolify: 2 resource).
# Lộ secret này = ai cũng tự ký link xem được.
# XOAY KHÔNG DOWNTIME: đặt secret mới vào VTC_HLS_SECRET, chuyển secret cũ xuống
# VTC_HLS_SECRET_PREVIOUS (2 bên giống nhau) → recreate/redeploy → báo đối tác pull
# lại danh mục → khi xong + quá TTL link ngắn nhất thì xóa PREVIOUS → recreate/redeploy.
VTC_HLS_SECRET=doi-thanh-chuoi-ngau-nhien-khac-64-ky-tu
VTC_HLS_SECRET_PREVIOUS=
# Khóa API cho đối tác kéo luồng (VTVgo): "ten:key,ten2:key2", header Authorization: Bearer <key>.
# Key = full quyền API — giữ kín như mật khẩu. Thu hồi = xóa khỏi danh sách + restart backend.
VTC_PARTNER_KEYS=vtvgo:doi-thanh-key-dai-ngau-nhien
VTC_ADMIN_USER=admin
VTC_ADMIN_EMAIL=ky-thuat@don-vi.vn
VTC_ADMIN_PASS=mat-khau-manh-toi-thieu-12-ky-tu
VTC_COOKIE_SECURE=1
VTC_TELEGRAM_BOT_TOKEN=
VTC_TELEGRAM_CHAT_ID=
# Mail khôi phục mật khẩu (để trống = chỉ log link reset ra log file)
VTC_SMTP_HOST=
VTC_SMTP_PORT=587
VTC_SMTP_USER=
VTC_SMTP_PASS=
VTC_SMTP_FROM=VTC Catchup <no-reply@vtctech.xyz>
VTC_PUBLIC_BASE_URL=https://catchup.vtcrd.top
# EPG đối tác (lịch đã duyệt): base URL + key + nhịp worker (phút).
VTC_EPG_BASE_URL=https://nhaplieu.vtctech.xyz/api/v1
VTC_EPG_API_KEY=
VTC_EPG_SYNC_MINUTES=10
# Vận hành (PORT 18080 để tránh trùng dashboard Traefik :8080 trên host)
PORT=18080
VTC_LOG_DIR=/app/storage/logs
VTC_GC_ENABLE=1
VTC_HLS_WATCHDOG=1
