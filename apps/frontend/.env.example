# Backend API (dev chạy backend local :8080; Prod: origin API, VD http://10.0.1.1:18080).
# Đọc theo từng request (runtime) — đổi chỉ cần restart container, không rebuild.
VTC_API_ORIGIN=http://127.0.0.1:8080
# Thư mục RAMDisk chứa HLS live (route /hls đọc trực tiếp, cả dev lẫn prod).
# Dev không có RAMDisk thì trỏ sang thư mục chứa index.m3u8 test.
VTC_LIVE_DIR=/media/ramdisk/live
# Secret ký link xem HLS — BẮT BUỘC giống backend ở Prod (thiếu là route /hls mở toang).
VTC_HLS_SECRET=
