# Backend API của VTCAIO (chạy song song hệ cũ: hệ cũ :18080, VTCAIO :18081).
# Dev chạy backend local :8080; Prod Coolify: origin API, VD http://10.0.1.1:18081.
# Đọc theo từng request (runtime) — đổi chỉ cần restart container, không rebuild.
VTC_API_ORIGIN=http://127.0.0.1:8080
# Thư mục RAMDisk chứa HLS live của VTCAIO (route /hls đọc trực tiếp, cả dev lẫn prod).
# Prod VTCAIO: /media/ramdisk/vtcaio (hệ cũ giữ /media/ramdisk/live).
# Dev không có RAMDisk thì trỏ sang thư mục chứa index.m3u8 test.
VTC_LIVE_DIR=/media/ramdisk/vtcaio
# Secret ký link xem HLS — BẮT BUỘC giống backend ở Prod (thiếu là route /hls mở toang).
VTC_HLS_SECRET=
