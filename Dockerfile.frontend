# Frontend Prod — multi-stage, chạy standalone (nhẹ, không cần source).
FROM node:20-alpine AS deps
WORKDIR /app
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/frontend ./
# Standalone output (cấu hình trong next.config.js) để image runner gọn.
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

RUN addgroup -S nextjs && adduser -S nextjs -G nextjs
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# Standalone KHÔNG tự kèm public/ — thiếu dòng này là mọi file tĩnh (logo SVG...)
# 404 dù build có đủ (đúng lỗi vừa gặp: favicon là route nên vẫn lên).
COPY --from=builder /app/public ./public
USER nextjs
EXPOSE 3000
# Healthcheck theo đúng PORT runtime (Coolify có thể đặt 3000/8067/..., Next.js
# nghe theo process.env.PORT nên check cứng 1 cổng là tự sát như vừa gặp).
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:${PORT:-3000}/login >/dev/null || exit 1
CMD ["node", "server.js"]
